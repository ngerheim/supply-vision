# Horários locais no formato HH:MM, separados por vírgula.
ALERTAS_HORARIOS=08:00,11:00,14:00,17:00
ALERTAS_HORARIOS_SEX=08:00,11:00,14:00
ALERTAS_HORARIOS_SAB=
ALERTAS_HORARIOS_DOM=
BACKUP_HORARIOS=13:30,20:59
LIMPEZA_HORARIO=19:00
ESPACO_MINIMO_GB=10

# Reprocessamento diário da Análise: refaz os últimos N dias com os acordos,
# cadastros e De/Para atuais (só atualiza o Portal, sem planilha). Horários
# HH:MM separados por vírgula, longe dos horários dos alertas; vazio desliga.
# Pare e inicie após alterar.
ANALISE_REPROCESSAMENTO_HORARIOS=06:30,19:30
ANALISE_REPROCESSAMENTO_DIAS=400

# Avisos de problemas e da partida ao administrador; ausente/vazio desliga.
# Um ou mais endereços separados por vírgula. Pare e inicie após alterar.
# ADMIN_ALERTA_EMAIL=administrador@example.com,outro@example.com

# Expurgo de registros operacionais: desligado por padrao. 0 dias preserva o tipo.
# Backup de rede confirmado antecede expurgos; sem candidatos nao ha backup. audit_logs e ticket_events ficam.
EXPURGO_HABILITADO=0
EXPURGO_EMAILS_DIAS=180
EXPURGO_RELATORIOS_DIAS=90
EXPURGO_IMPORTACOES_DIAS=180
