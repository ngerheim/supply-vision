# Dados operacionais, credenciais e resultados reais
/privado/
/privado.ensaio-*/

# Arquivos temporários e dependências locais dos módulos
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/dist/
**/work/
**/coverage/

# Artefatos locais de execução
**/*.log
**/*.lock
**/*.pid
**/.DS_Store

# Estado residual de instalacoes antigas pode conter banco e dados sensiveis.
**/.wrangler/

# Defesa contra dados reais fora da area privada
*.xlsx
*.xls
*.csv
!*.exemplo.csv
/docs/AVALIACAO-*.md
/docs/REVISAO-*.md
*.sqlite
*.sqlite-*
*.db
*.env
*.env.*
!*.env.example

# Saida de arquivos entregues pelo Claude; nao faz parte do projeto.
Claude outputs/
