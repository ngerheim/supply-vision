/_aud/
.pytest_cache/
__pycache__/
*.py[cod]
*.bak
*.bak_*
.venv/
venv/
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*

# Rascunho de trabalho, nao vai para o publico.
/CLAUDE.md
/PENDENCIAS.md
/resposta_revisao.md
/handoff.md
/atualizar_tarefas_para_C_Projetos.ps1
