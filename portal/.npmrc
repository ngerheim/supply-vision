# O ambiente deste computador tem NODE_ENV=production definido globalmente.
# Sem este arquivo, qualquer "npm install" apaga TODAS as devDependencies do
# projeto -- inclusive vinext, o Vite e o wrangler -- e o portal
# para de subir com "Cannot find package".
#
# include=dev forca a instalacao das dependencias de desenvolvimento
# independentemente do NODE_ENV.
include=dev
