# Copie para privado/portal/configuracao/portal.env.
PORTAL_URL=http://localhost:3000
# Porta local do servidor; ausente/vazia conserva 3000, independente da URL publica.
PORTAL_PORTA=
# Os alertas no mesmo servidor usam loopback para HTTP, sem enviar o token na LAN.
# Para portal em outro servidor, informe aqui um endereço HTTPS sem redirecionamento.
PORTAL_INTERNAL_URL=
# Preenchido automaticamente pelo instalador/atualizador.
PORTAL_API_TOKEN=
BACKUP_EMAIL_TO=administrador@example.com
BACKUP_NETWORK_DIR=
# Prazo por tentativa SMB (1 a 600 segundos); novas tentativas a cada 10 min por 1 h.
BACKUP_NETWORK_TIMEOUT_SECONDS=60
BACKUP_7ZIP_EXE=C:\Program Files\7-Zip\7z.exe
BACKUP_7ZIP_MIN_VERSION=24.09
# Somente em falha da rede; acima do limite, envia apenas alerta.
BACKUP_EMAIL_MAX_MB=15
# BACKUP_ANEXAR_BANCO legado e aceito, mas ignorado. Nao ha comprovante diario.

# Lidas pelo servidor Node na partida.
# INITIAL_ADMIN_PASSWORD so e usada quando a base esta vazia; apague depois
# de criar as contas reais.
INITIAL_ADMIN_PASSWORD=

# Aba "Manutencao": relatorio publicado no Power BI que ela emoldura.
# PBI_RELATORIO_URL: link de Publicar na web ou Inserir relatorio > Site ou portal.
# Publicar na web permite acesso anonimo fora do Portal; modo aceito pela operacao.
# PBI_PAGINA e o identificador da pagina que deve abrir (ver AGENTS.md#portal-e-banco).
# Lidos quando o Portal sobe: depois de trocar, basta reiniciar a operacao.
PBI_RELATORIO_URL=
PBI_PAGINA=
