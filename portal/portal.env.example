# Copie para privado/portal/configuracao/portal.env.
PORTAL_URL=http://localhost:3000
# Preenchido automaticamente pelo instalador/atualizador.
PORTAL_API_TOKEN=
BACKUP_EMAIL_TO=administrador@example.com
BACKUP_NETWORK_DIR=

# O e-mail de backup leva so o comprovante enquanto houver copia de rede.
# true volta a anexar o banco -- que contem hashes de senha e toda a base.
BACKUP_ANEXAR_BANCO=

# Entregues ao Worker pelo scripts/iniciar-portal.mjs.
# INITIAL_ADMIN_PASSWORD so e usada quando a base esta vazia; apague depois
# de criar as contas reais. TRUSTED_PROXY=true exige proxy reverso confiavel.
INITIAL_ADMIN_PASSWORD=
TRUSTED_PROXY=

# Aba "Manutencao": relatorio publicado no Power BI que ela emoldura.
# PBI_RELATORIO_URL e o link de "Publicar na web" do relatorio.
# PBI_PAGINA e o identificador da pagina que deve abrir (ver docs/OPERAR.md).
# Lidos quando o Portal sobe: depois de trocar, basta reiniciar a operacao.
PBI_RELATORIO_URL=
PBI_PAGINA=
